[Unit]
Description=MK landing and backend
After=network.target

[Service]
Type=simple
User=mk-landing
Group=mk-landing
WorkingDirectory=/opt/mk-landing/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/mk-landing.env
ExecStart=/usr/bin/node /opt/mk-landing/current/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/mk-landing /opt/mk-landing/current/.next/cache

[Install]
WantedBy=multi-user.target
