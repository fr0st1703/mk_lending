# Real public origin enables canonical, sitemap and indexing.
NEXT_PUBLIC_SITE_URL=
# Node.js 24+, one persistent server, local setup: npm run admin:setup
APP_ORIGIN=http://127.0.0.1:3000
# Optional public view-counter origin when admin is accessed via an SSH tunnel.
# Normally leave empty so it follows APP_ORIGIN.
VIEWS_ORIGIN=
DATABASE_PATH=data/landing.sqlite
ADMIN_PASSWORD_HASH=
LEADS_ENABLED=false
# Set only after completing the operator details and reviewing the policy.
POLICY_READY=false
OPERATOR_ADDRESS=
# x-real-ip must be overwritten by your trusted reverse proxy; never expose Node directly.
TRUST_PROXY=false
# Informational infrastructure flag, not an external uptime/SSL check.
INFRA_READY=false
